# Variables de entorno — Magna App
# Copia este archivo como .env y ajusta los valores

# Credenciales del primer admin (se crea automáticamente al iniciar)
ADMIN_USER=admin
ADMIN_PASSWORD=magna2024
ADMIN_NOMBRE=Administrador

# Clave secreta para JWT — ¡CÁMBIALA en producción!
SECRET_KEY=cambia-esto-por-una-clave-segura-larga-y-aleatoria

# Base de datos (SQLite por defecto; PostgreSQL como alternativa)
DATABASE_URL=sqlite:///./asistencia.db
# DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/magna
